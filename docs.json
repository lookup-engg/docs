      "format": "woff2"
    },
    "body": {
      "family": "Google Sans",
      "weight": 400,
      "source": "/fonts/googlesanslatin.woff2",
      "format": "woff2"
    }
  },
  "appearance": {
    "strict": true,
    "default": "light"
  },
