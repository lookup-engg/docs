  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go To Velo",
      "href": "https://app.usevelo.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/sharewithvelo",
      "linkedin": "https://www.linkedin.com/company/useveloai"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Garant Pro",
      "weight": 700,
      "source": "/fonts/garantprobold.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Google Sans",
      "weight": 400,
      "source": "/fonts/googlesanslatin.woff2",
      "format": "woff2"
    }
  },
  "appearance": {
    "strict": true,
    "default": "light"
  },
  "redirects": [
    {
      "source": "/capture-screen/:slug*",
      "destination": "/creating-a-velo/capture-screen"
    },
    {
      "source": "/upload-recording/:slug*",
      "destination": "/creating-a-velo/upload-recording"
