    "links": [
      {
        "label": "Blog",
        "href": "https://usevelo.ai/blog/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Velo for free",
      "href": "https://app.usevelo.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
