# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# ---------------------------------------------------------------------------
# REPO DOCUMENTS, NOT SITE PAGES
#
# Mintlify auto-ignores README / LICENSE / CHANGELOG / CONTRIBUTING but nothing
# else at the root, so any other .md here is built and served even though it is
# absent from docs.json. These are internal working documents.
# ---------------------------------------------------------------------------
/AGENTS.md
/DOCS-STRUCTURE.md
/NEW-DOCS-STRUCTURE.md

# Draft content
drafts/
*.draft.mdx

# Authoring tooling (not documentation)
/scripts/

# ---------------------------------------------------------------------------
# ARCHIVED PAGES
#
# These pages are superseded by the current navigation in docs.json but are
# retained in git for reference. They are excluded from the build so they are
# neither served nor indexed. docs.json redirects their URLs to the current
# equivalents.
#
# Do not edit or link to anything below this line. If you need content from
# one of these pages, move it into the live page and leave the original here.
# ---------------------------------------------------------------------------

